  "query": "SELECT f.id, f.slug, f.display_name, f.source_id,\n                f.filter_type as \"filter_type: FilterType\",\n                f.output_format as \"output_format: OutputFormat\",\n                s.slug AS source_slug\n         FROM filters f\n         JOIN sources s ON f.source_id = s.id\n         ORDER BY f.slug",
